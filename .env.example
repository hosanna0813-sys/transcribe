# =============================================================
# 環境變數總覽(範例;不得填入真實金鑰後提交)
# 後端(Render / 家用中繼)讀取;前端頁面不讀取任何機密。
# =============================================================

# --- 環境 ---
# development(預設):缺設定時可用測試值(ECPay 公開測試金鑰等)
# production:fail closed —— 缺正式金鑰時停用對應功能,絕不退回測試值
APP_ENV=development

# --- OpenAI(付費轉錄與免費試用共用;未設則兩者停用,byok 不受影響) ---
OPENAI_API_KEY=

# --- 原始檔案大小上限(上傳檔 / YouTube 原始音訊;預設 500 MB) ---
# 系統會先壓縮再切段,長度不受此限;此值只擋「原始檔案大小」。
# 檔案越大,Render 磁碟與上傳時間負擔越大;免費方案不建議超過 500。
MAX_UPLOAD_MB=

# --- Supabase(登入驗證 JWT、額度帳務;anon key 只在前端,屬公開值) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- 家用 YouTube 中繼 ---
# 後端呼叫的中繼網址(只存在後端環境,不放前端)。
# 可填多個(逗號分隔)做備援/分流:後端會依序嘗試,某台關機/失敗自動換下一台;
# 多台需共用同一 RELAY_SHARED_SECRET。例:https://a.ngrok-free.app,https://b.ngrok-free.app
HOME_RELAY_URL=
# 與家用機相同的共享密鑰;後端用它對中繼請求簽章(HMAC-SHA256)
RELAY_SHARED_SECRET=
# 家用機設 1:強制驗證簽章,未帶有效簽章一律 403(Render 不要設)
RELAY_REQUIRE_AUTH=
# 中繼下載上限(選填;預設 512MB / 1800 秒)
MAX_RELAY_DOWNLOAD_BYTES=
MAX_RELAY_DOWNLOAD_SECONDS=
# 家用中繼:/audio 下載槽滿時最多等待秒數(預設 180)、單次下載硬逾時秒數(預設 1500)
RELAY_SLOT_WAIT_SECONDS=
FETCH_MAX_SECONDS=

# --- 金流(綠界 ECPay) ---
# production 缺任一值 → 儲值功能停用;development 缺值 → 用綠界公開測試金鑰
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# stage(測試)/ production(正式)
ECPAY_ENV=stage
# 本後端公開網址(組付款回呼 ReturnURL 用;production 必填)
PUBLIC_BASE_URL=
# 前端 v2 網址(付款後導回)
SITE_V2_URL=

# --- 額度與試用 ---
# 每帳號每日免費分鐘(0 或不設 = 關閉)
FREE_DAILY_MINUTES=
# 免登入試用:每 IP/裝置 每日分鐘(預設 10)
TRIAL_MINUTES=
# 免登入試用:全站每日總分鐘上限(預設 300;0=不限)
TRIAL_DAILY_TOTAL_MINUTES=

# --- 背景任務就地 Worker(選填) ---
# 同時處理數(免費方案單實例,預設 1;記憶體足夠可設 2)
WORKER_CONCURRENCY=
# 同一任務內分段並行轉錄數(預設 6;成本不變,只影響速度)
CHUNK_WORKERS=

# --- 校正模型(選填,預設 gpt-4o-mini) ---
CORRECTION_MODEL=

# --- 成本統計價格覆蓋(選填,單位美元;不設用內建預設) ---
PRICE_WHISPER_PER_MIN=
PRICE_GPT_4O_MINI_IN_PER_1M=
PRICE_GPT_4O_MINI_OUT_PER_1M=

# --- 診斷(選填;未設定時 /diag 一律 404) ---
DIAG_TOKEN=

# --- 家用中繼專用(server/home/.env) ---
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
